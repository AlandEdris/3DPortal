rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. User Profiles & Nicknames (voxelorbit_users)
    // Open read & write so users can save nicknames without permission errors
    match /voxelorbit_users/{userId} {
      allow read, write: if true;
    }

    // 2. 3D Model Catalog (voxelorbit_models)
    // Allows full access to sync, upload, rename, and delete 3D models
    match /voxelorbit_models/{modelId} {
      allow read, write: if true;
    }

    // 3. Activity Logs & Duplicate Tracking (voxelorbit_activity_logs)
    // Allows logging and viewing all actions (add, rename, delete, update, duplicate skipped)
    match /voxelorbit_activity_logs/{logId} {
      allow read, write: if true;
    }
  }
}
